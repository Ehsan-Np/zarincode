<?xml version="1.0"?>
<ruleset name="Zarincode">
  <description>Zarincode WordPress coding standard.</description>
  <file>functions.php</file><file>inc</file><file>templates</file><file>template-parts</file><file>woocommerce</file>
  <exclude-pattern>vendor/*</exclude-pattern><exclude-pattern>demo/*</exclude-pattern>
  <arg name="extensions" value="php"/><arg value="ps"/><arg name="colors"/>
  <rule ref="WordPress-Core"/><rule ref="WordPress-Extra"/><rule ref="WordPress-Docs"/>
  <rule ref="PHPCompatibilityWP"><properties><property name="testVersion" value="7.4-"/></properties></rule>
  <config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
